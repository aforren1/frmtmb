par_template(bf(y ~ x + (1 | g)) + gaussian(), data = dd)

# after fitting: the same layout, holding the estimates
fit <- frm(bf(y ~ x + (1 | g)) + gaussian(), dd)
par_template(fit)

# discover, edit, fit
st <- par_template(bf(y ~ x) + gaussian(), data = dd)
st$beta["x"] <- 2
frm(bf(y ~ x) + gaussian(), dd, start = st)
}
