== F. brms Stan code: where the class b prior lands
-- y ~ 0 + Intercept + x, class b 
  vector[K] b;  // regression coefficients
  lprior += normal_lpdf(b | 0, 1);
  lprior += student_t_lpdf(sigma | 3, 0, 2.5)
-- bf(y ~ x, center = FALSE), class b 
  vector[K] b;  // regression coefficients
  lprior += normal_lpdf(b | 0, 1);
  lprior += student_t_lpdf(sigma | 3, 0, 2.5)
-- sigma ~ 0 + Intercept + z, class b dpar sigma 
  vector[Kc] means_X;  // column means of X before centering
    means_X[i - 1] = mean(X[, i]);
    Xc[, i - 1] = X[, i] - means_X[i - 1];
  vector[Kc] b;  // regression coefficients
  real Intercept;  // temporary intercept for centered predictors
  vector[K_sigma] b_sigma;  // regression coefficients
  lprior += student_t_lpdf(Intercept | 3, 3.6, 2.5);
  lprior += normal_lpdf(b_sigma | 0, 1);
    mu += Intercept + Xc * b;
  real b_Intercept = Intercept - dot_product(means_X, b);
