== build LANE : frmtmb 0.64.0  brms 2.23.0 
table(fu) = 150 250 0  levels a,b,c

### yo ~ x + cs(fc)
  brms X      : x
  brms Xcs    : fcb,fcc
  brms b coefs: fcb,fcc,x
  frmtmb      : bcs_fcb[1],bcs_fcb[2],bcs_fcc[1],bcs_fcc[2]  |fixef| 7
  frmtmb b coefs: x,fcb,fcc

### yo ~ x + cs(fch) character
  brms X      : x
  brms Xcs    : fchb,fchc
  brms b coefs: fchb,fchc,x
  frmtmb      : bcs_fchb[1],bcs_fchb[2],bcs_fchc[1],bcs_fchc[2]  |fixef| 7
  frmtmb b coefs: x,fchb,fchc

### yo ~ x + cs(fnum)
  brms X      : x
  brms Xcs    : fnum2,fnum3
  brms b coefs: fnum2,fnum3,x
  frmtmb      : bcs_fnum2[1],bcs_fnum2[2],bcs_fnum3[1],bcs_fnum3[2]  |fixef| 7
  frmtmb b coefs: x,fnum2,fnum3

### yo ~ x + cs(fo) ORDERED
  brms X      : x
  brms Xcs    : fo.L,fo.Q
  brms b coefs: fo.L,fo.Q,x
  frmtmb      : bcs_fo.L[1],bcs_fo.L[2],bcs_fo.Q[1],bcs_fo.Q[2]  |fixef| 7
  frmtmb b coefs: x,fo.L,fo.Q

### yo ~ x + cs(fu) UNUSED LEVEL
  brms X      : x
  brms Xcs    : fub
  brms b coefs: fub,x
  frmtmb      : bcs_fub[1],bcs_fub[2]  |fixef| 5
  frmtmb b coefs: x,fub

### yo ~ fu + cs(z) unused level in X
  brms X      : fub
  brms Xcs    : z
  brms b coefs: fub,z
  frmtmb      : bcs_z[1],bcs_z[2]  |fixef| 5
  frmtmb b coefs: fub,z

### yo ~ cs(fc) + cs(z)
  brms X      : 
  brms Xcs    : fcb,fcc,z
  brms b coefs: fcb,fcc,z
  frmtmb      : bcs_fcb[1],bcs_fcb[2],bcs_fcc[1],bcs_fcc[2],bcs_z[1],bcs_z[2]  |fixef| 8
  frmtmb b coefs: fcb,fcc,z

### yo ~ x + cs(x) the refused one
  brms X      : x
  brms Xcs    : x
  brms b coefs: x
  frmtmb      : REFUSED: cs(x) is not identified in 'yo.mu': the column is already spanned by the population-level part of the predictor, so adding a constant to the population-level coefficient and subtracting the same constant from every threshold's coefficient leaves the 
  frmtmb b coefs: -

### ordered factor: are the stored columns brms's Xcs values?
  brms Xcs colnames  : fo.L,fo.Q
  frmtmb cs labels   : csfo.L,csfo.Q
  column 1: max abs difference = 0  identical = TRUE
  column 2: max abs difference = 0  identical = TRUE

### brms's own Kcs and the stan declaration on the unused level
  brms Kcs = 1  Xcs colnames = fub
  brms Xcs column sums = 250

DONE  LANE 
