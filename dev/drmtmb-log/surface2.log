=== drm: binary missing predictor, impute_model(binomial)
{
    dm <- d
    dm$bx <- rbinom(nrow(dm), 1, plogis(dm$z))
    dm$y <- dm$y + 0.5 * dm$bx
    dm$bx[seq(1, nrow(dm), 7)] <- NA
    D(dbf(y ~ x + mi(bx), sigma ~ 1), family = gaussian(), data = dm, impute = list(bx = drmTMB::impute_model(bx ~ 
        z, family = binomial())), missing = drmTMB::miss_control(predictor = "model"))
} 
  FITTED. logLik = -815.364208204  convergence = 0 ( relative convergence (4) )

