anova.drmTMB:
function (object, ..., test = NULL) 
{
    fits <- c(list(object), list(...))
    mspl <- vapply(fits, drm_is_mspl, logical(1L))
    if (any(mspl)) {
        drm_abort_mspl_inference(fits[[which(mspl)[[1L]]]], "anova")
    }
    cli::cli_abort("{.fn anova} likelihood-ratio comparisons are not implemented for {.cls drmTMB} fits.")
}
