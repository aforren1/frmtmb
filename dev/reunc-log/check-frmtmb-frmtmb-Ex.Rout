> 
> set.seed(1)
> dd <- data.frame(x = rnorm(120), g = factor(rep(1:12, each = 10)))
> dd$y <- rnorm(120, 1 + 2 * dd$x + rnorm(12, 0, 0.5)[dd$g], 0.4)
> fit <- frm(bf(y ~ x + (1 | g)), data = dd)
> nd <- data.frame(x = c(-1, 0, 1), g = factor(1, levels = levels(dd$g)))
