> base::assign(".ptime", proc.time(), pos = "CheckExEnv")
> ### Name: vcov.frmtmb_fit
> ### Title: Covariance matrix of the fixed-effect estimates
> ### Aliases: vcov.frmtmb_fit
> 
> ### ** Examples
> 
> set.seed(1)
> dd <- data.frame(x = rnorm(100), g = factor(rep(1:10, 10)))
> dd$y <- rnorm(100, 1 + 0.5 * dd$x + rnorm(10, 0, 0.8)[dd$g], 1)
> fit <- frm(bf(y ~ x + (1 | g)) + gaussian(), data = dd)
> 
> # standard errors of the fixed effects, which is fixef()'s Est.Error
> sqrt(diag(vcov(fit)))
Intercept         x 
0.2745663 0.1132852 
> # the covariance parameters join the block on their internal scale,
> # under the internal names, which is confint()'s vocabulary
> rownames(vcov(fit, full = TRUE))
[1] "(Intercept)"       "x"                 "sigma_(Intercept)"
[4] "theta_1"          
> 
> # the matrix is what a delta-method calculation needs
> V <- vcov(fit)
> a <- c(1, 2)                       # prediction at x = 2, no group
> sqrt(drop(t(a) %*% V[1:2, 1:2] %*% a))
[1] 0.348039
> 
> 
> 
> base::assign(".dptime", (proc.time() - get(".ptime", pos = "CheckExEnv")), pos = "CheckExEnv")
> base::cat("vcov.frmtmb_fit", base::get(".format_ptime", pos = 'CheckExEnv')(get(".dptime", pos = "CheckExEnv")), "\n", file=base::get(".ExTimings", pos = 'CheckExEnv'), append=TRUE, sep="\t")
> cleanEx()
> nameEx("vcov_cluster")
> ### * vcov_cluster
> 
> flush(stderr()); flush(stdout())
> 
> base::assign(".ptime", proc.time(), pos = "CheckExEnv")
> ### Name: vcov_cluster
> ### Title: Cluster-robust (sandwich) covariance
> ### Aliases: vcov_cluster
> 
> ### ** Examples
> 
> set.seed(1)
> G <- 40
> dd <- data.frame(g = factor(rep(seq_len(G), each = 6)),
+                  x = rnorm(G * 6))
> # cluster-specific error scale the model does not describe
> dd$y <- 1 + 0.5 * dd$x +
+   rnorm(G * 6, 0, rep(runif(G, 0.3, 2.5), each = 6))
> fit <- frm(bf(y ~ x + (1 | g)) + gaussian(), data = dd,
+            REML = FALSE)
> 
> sqrt(diag(vcov(fit)))                          # model-based
Intercept         x 
 0.107877  0.112256 
> sqrt(diag(vcov_cluster(fit, ~ g, "CR1")))      # cluster-robust
      (Intercept)                 x sigma_(Intercept) 
       0.09237769        0.12179568        0.08048348 
> 
> # feeds straight into the inference methods, which need the whole
> # outer parameter vector and pick up the t(G - 1) reference from it
> confint(fit, parm = "x",
+         vcov = vcov_cluster(fit, ~ g, "CR1", full = TRUE))
        lwr       upr       est
x 0.4379456 0.9306556 0.6843006
> 
> 
> 
> base::assign(".dptime", (proc.time() - get(".ptime", pos = "CheckExEnv")), pos = "CheckExEnv")
