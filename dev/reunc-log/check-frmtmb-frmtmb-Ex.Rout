> ### Name: frm_multiple
> ### Title: Fit a model across multiply imputed datasets
> ### Aliases: frm_multiple
> 
> ### ** Examples
> 
> set.seed(8)
> n <- 80
> x <- rnorm(n)
> y <- rnorm(n, 1 + 0.5 * x, 1)
> x[sample(n, 15)] <- NA
> imps <- lapply(1:3, function(i) {
+   xi <- x
+   xi[is.na(xi)] <- sample(x[!is.na(x)], sum(is.na(xi)), TRUE)
+   data.frame(y = y, x = xi)
+ })
