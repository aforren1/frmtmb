+   fit <- frm(bf(y ~ x + (1 | g)), family = gaussian(), data = dd)
+   ds <- frm_sample(fit, chains = 1, iter = 500, refresh = 0)
+ 
+   ll <- log_lik(ds)
+   dim(ll)
+   # the column means are the per-observation expected log-densities
+   head(colMeans(ll))
+ }
