+#' Whether a fit restarted from the scan of nonlinear intercepts stands.
+#'
+#' A scan finds a point where the body is defined, not the region of the
+#' maximum, and from a wrong region nlminb either stops short or
+#' converges where the model degenerates: on the review's sinusoid it
+#' reported code 0 at a straight line, 176 log-likelihood units below
+#' the maximum, and on a Michaelis-Menten curve it ran to negative
+#' parameters (dev/postfix-rev-nlscan.R). So the fit stands only when it
+#' converged (code 0) and the standard-error analysis loses nothing.
+#' Otherwise the default start's own error stands, as in frmtmb 0.70.0,
+#' and names the scan's point as a candidate `start`. A ridge the model
+#' has by construction (`a + b` with shared terms) loses its standard
+#' errors, so it is refused too: no start identifies it.
+#'
+#' @noRd
+nl_scan_accept <- function(fit, state, spec, start, REML, control,
+                           quadrature, prior, announce) {
+  conv <- fit$opt$convergence
+  why <- if (!isTRUE(conv == 0)) {
+    paste0("the fit from it did not converge (", fit$opt$message, ")")
+  } else {
+    an <- tryCatch(se_fit_analysis(fit, force = TRUE),
+                   error = function(e) NULL)
+    if (is.null(an)) {
+      "its fit could not be checked for standard errors"
+    } else if (length(an$lost)) {
+      paste0("its fit loses the standard errors of ",
+             paste(names(an$lost), collapse = ", "),
+             " (not a clean maximum)")
+    }
+  }
+  if (!is.null(why)) {
+    e <- state$err
+    attr(e, "nl_scan_note") <- nl_scan_note(state$scan, why)
+    fit_error_context(spec, start, REML, control, quadrature, prior,
+                      NULL, err = e)
+  }
+  fit$cache$nl_scan <- state$scan
+  if (announce) {
+    frm_message("The nonlinear fit failed from its default starting ",
+                "values (", conditionMessage(state$err), "). It was ",
+                "restarted from nonlinear intercepts a scan of the ",
+                "objective found: ", nl_scan_values(state$scan), ". The ",
+                "fit converged with every standard error. A nonlinear ",
+                "likelihood can have more than one maximum; give ",
+                "`start` or a prior to choose the region.")
+  }
+  invisible(NULL)
+}
+
+#' The scan's point, as `name = value` pairs.
+#'
+#' @noRd
+nl_scan_values <- function(scan) {
+  paste(paste0(names(scan), " = ", vapply(scan, format, "")),
+        collapse = ", ")
+}
+
+#' What the error of a refused or failed scan restart adds: the scan's
+#' point and why it was not kept, written as a `start` the caller can
+#' try.
+#'
+#' @noRd
+nl_scan_note <- function(scan, why) {
+  paste0(". A scan of the nonlinear intercepts found ",
+         nl_scan_values(scan), ", but ", why, ", so no fit is returned. ",
+         "A candidate to try: start = list(beta = c(",
+         paste(paste0("\"", names(scan), "\" = ",
+                      vapply(scan, format, "")), collapse = ", "),
+         "))")
 }
 
