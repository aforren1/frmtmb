+#' A start for a nonlinear model whose body is undefined at the default
+#' start, found by the objective itself.
+#'
+#' Every nonlinear coefficient starts at zero unless `start` or a prior
+#' places it, and a body is often outside the family's domain there:
+#' `count ~ a + b` on `Gamma("identity")` has a mean of exactly zero,
+#' where the density is not defined, so the objective and every
+#' gradient component are NaN and nlminb stops before its first step
+#' (ledger row brmsfit-methods:955). The intercepts of the nonlinear
+#' parameters are the coordinates that move the body's level without
+#' choosing between its covariates, so they move together, to one
+#' common value `c`, with every slope left at zero. `c` runs over a
+#' grid of signs and powers of ten, which assumes nothing about the
+#' units of the response or of the body, and the start is the value
+#' with the lowest finite objective. A coefficient that `start` or a
+#' prior placed keeps its place, and so does a model with no
+#' nonlinear intercept or no `beta` among the outer parameters (REML
+#' and `profile = TRUE` integrate it out). `NULL` when no grid value
+#' gives a finite objective. Only ever tried after the first attempt
+#' failed, so no fit that converged moves.
+#'
+#' @noRd
+nl_intercept_scan <- function(obj, frame, start, prior_entries, placed) {
+  if (!"beta" %in% names(obj$par)) return(NULL)
+  # the same nonlinear sub-formulas nl_beta_positions() reads
+  idx <- integer(0)
+  for (lp in frame[["linpreds"]]) {
+    if (!identical(lp[["par"]], "beta")) next
+    if (!is.null(lp[["nl_body"]]) || !is.null(lp[["constant"]])) next
+    nl <- frame[["spec"]]$responses[[lp[["resp"]]]]$nlpars %||% character(0)
+    if (!lp[["dpar"]] %in% nl) next
+    icpt <- match("(Intercept)", colnames(lp[["X"]]))
+    if (!is.na(icpt)) idx <- c(idx, as.integer(lp[["idx"]][icpt]))
+  }
+  claimed <- c(vapply(placed, function(p) p$idx, 1L),
+               if (!is.null(start[["beta"]])) {
+                 start_claimed_idx(frame[["par_template"]][["beta"]],
+                                   start[["beta"]], "beta")
+               })
+  idx <- setdiff(idx, claimed)
+  if (!length(idx)) return(NULL)
+  f <- function(p) {
+    tryCatch(as.numeric(obj$fn(p)), error = function(e) NA_real_)
+  }
+  tpl <- make_start(frame, start, prior_entries)
+  best <- NULL
+  best_val <- Inf
+  for (cv in as.vector(t(c(1, -1) %o% 10^(-2:3)))) {
+    tpl[["beta"]][idx] <- cv
+    p <- outer_from_template(tpl, obj, frame)
+    if (is.null(p)) return(NULL)
+    val <- f(p)
+    if (is.finite(val) && val < best_val) {
+      best <- p
+      best_val <- val
+    }
+  }
+  if (is.null(best)) return(NULL)
+  # One common value cannot give two intercepts two scales: the
+  # insurance-loss curve of brms_nonlinear wants ult near 5000, omega
+  # near 1 and theta near 50, and from the best common value nlminb
+  # stopped 101 log-likelihood units short of the maximum
+  # (dev/postfix-nlscan-loss.R). Two passes then move one intercept at
+  # a time over a finer grid, zero included, keeping each improvement.
+  grid <- c(0, as.vector(t(c(1, -1) %o% as.vector(c(1, 2, 5) %o%
+                                                    10^(-2:3)))))
+  pos <- which(names(obj$par) == "beta")[idx]
+  for (pass in 1:2) {
+    for (k in pos) {
+      for (cv in grid) {
+        p <- best
+        p[k] <- cv
+        val <- f(p)
+        if (is.finite(val) && val < best_val) {
+          best <- p
+          best_val <- val
+        }
+      }
+    }
+  }
+  attr(best, "nl_scan") <- stats::setNames(
+    best[pos], par_template_names(frame[["par_template"]][["beta"]],
+                                  "beta")[idx])
+  best
+}
